{
  "name": "NovaScript",
  "scopeName": "source.nova",
  "fileTypes": [
    "nova"
  ],
  "firstLineMatch": "^#!.*\\bnova.py\\b",
  "patterns": [
    {
      "match": "^(#!)((?:.*/)?(?:env\\s+)?)(nova.py)",
      "captures": {
        "1": {
          "name": "punctuation.definition.comment.shebang"
        },
        "2": {
          "name": "comment.line.shebang.path"
        },
        "3": {
          "name": "constant.language.interpreter.nova"
        }
      }
    },
    {
      "match": "^(#!)((?:.*/)?(?:env\\s+)?)([a-zA-Z][a-zA-Z_]+)",
      "captures": {
        "1": {
          "name": "punctuation.definition.comment.shebang"
        },
        "2": {
          "name": "comment.line.shebang.path"
        },
        "3": {
          "name": "constant.language.interpreter.nova"
        }
      }
    },
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#function_definitions"
    },
    {
      "include": "#namespace_definition"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#builtins"
    },
    {
      "include": "#decorators"
    },
    {
      "include": "#using_stmt"
    },
    {
      "include": "#function_calls"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#types"
    },
    {
      "include": "#custom_types"
    },
    {
      "include": "#enum_definition"
    },
    {
      "include": "#class"
    },
    {
      "match": "\\b[a-zA-Z_]\\w*\\b",
      "name": "variable.other.nova"
    }
  ],
  "repository": {
    "class": {
      "patterns": [
        {
          "match": "\\b(class|record|inherits|static|super)\\b",
          "name": "keyword.declaration.nova"
        }
      ]
    },
    "comments": {
      "patterns": [
        {
          "match": "//.*$",
          "name": "comment.line.double-slash.nova"
        },
        {
          "begin": "/\\*",
          "end": "\\*/",
          "name": "comment.block.nova"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "begin": "\"",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.nova"
            }
          },
          "end": "\"",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.nova"
            }
          },
          "name": "string.quoted.double.nova",
          "patterns": [
            {
              "match": "\\\\.",
              "name": "constant.character.escape.nova"
            }
          ]
        },
        {
          "begin": "'",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.nova"
            }
          },
          "end": "'",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.nova"
            }
          },
          "name": "string.quoted.single.nova",
          "patterns": [
            {
              "match": "\\\\.",
              "name": "constant.character.escape.nova"
            }
          ]
        },
        {
          "begin": "`",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.nova"
            }
          },
          "end": "`",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.nova"
            }
          },
          "name": "string.quoted.single.nova",
          "patterns": [
            {
              "match": "\\\\.",
              "name": "constant.character.escape.nova"
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "match": "\\b0[xX][0-9a-fA-F_]+\\b",
          "name": "constant.numeric.hex.nova"
        },
        {
          "match": "\\b0[uU][0-9a-fA-F_]+\\b",
          "name": "constant.character.unicode.nova"
        },
        {
          "match": "\\b-?\\d+(\\.\\d+)?\\b",
          "name": "constant.numeric.nova"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "match": "\\b(var|const|private|new|assert|local|with|func|def|return|define|export|unpack|compact)\\b",
          "name": "keyword.declaration.nova"
        },
        {
          "match": "\\bas\\b\\s+(\\w+)",
          "name": "keyword.declaration.nova",
          "captures": {
            "1": {
              "name": "entity.name.label.nova"
            }
          }
        },
        {
          "match": "\\b(for|break|continue|while|until|do|in|end|else|elseif|if|test|failed|defer)\\b",
          "name": "keyword.control.flow.nova"
        },
        {
          "match": "\\b(string|number|int|float|function|bool|void)\\b",
          "name": "storage.type.nova"
        },
        {
          "match": "\\b(undefined|nil|NaN)\\b",
          "name": "constant.language.nova"
        }
      ]
    },
    "namespace_definition": {
      "patterns": [
        {
          "match": "\\bscope\\b\\s+(\\w+)",
          "name": "keyword.declaration.nova",
          "captures": {
            "1": {
              "name": "entity.name.namespace.nova"
            }
          }
        }
      ]
    },
    "using_stmt": {
      "patterns": [
        {
          "begin": "\\b(using)\\b\\s*(\\[)",
          "beginCaptures": {
            "1": {
              "name": "keyword.declaration.nova"
            },
            "2": {
              "name": "punctuation.section.brackets.begin.nova"
            }
          },
          "end": "\\]",
          "endCaptures": {
            "0": {
              "name": "punctuation.section.brackets.end.nova"
            }
          },
          "name": "meta.using.nova",
          "contentName": "meta.using.list.nova",
          "patterns": [
            {
              "match": "\\s*,\\s*",
              "name": "punctuation.separator.comma.nova"
            },
            {
              "match": "([A-Za-z_]\\w*(?:\\.[A-Za-z_]\\w*)*)",
              "captures": {
                "1": {
                  "name": "entity.name.namespace.nova"
                }
              }
            },
            {
              "match": "\\s+",
              "name": "text.whitespace.nova"
            },
            {
              "match": ".",
              "name": "invalid.illegal.nova"
            }
          ]
        },
        {
          "begin": "\\b(using)\\b\\s*(\\{)",
          "beginCaptures": {
            "1": {
              "name": "keyword.declaration.nova"
            },
            "2": {
              "name": "punctuation.section.brackets.begin.nova"
            }
          },
          "end": "\\}",
          "endCaptures": {
            "0": {
              "name": "punctuation.section.brackets.end.nova"
            }
          },
          "name": "meta.using.nova",
          "contentName": "meta.using.list.nova",
          "patterns": [
            {
              "match": "\\s*,\\s*",
              "name": "punctuation.separator.comma.nova"
            },
            {
              "match": "([A-Za-z_]\\w*(?:\\.[A-Za-z_]\\w*)*)",
              "captures": {
                "1": {
                  "name": "entity.name.namespace.nova"
                }
              }
            },
            {
              "match": "\\s+",
              "name": "text.whitespace.nova"
            },
            {
              "match": ".",
              "name": "invalid.illegal.nova"
            }
          ]
        },
        {
          "match": "\\b(using)\\b\\s+([A-Za-z_]\\w*(?:\\.[A-Za-z_]\\w*)*)",
          "captures": {
            "1": {
              "name": "keyword.declaration.nova"
            },
            "2": {
              "name": "entity.name.namespace.nova"
            }
          }
        }
      ]
    },
    "function_definitions": {
      "patterns": [
        {
          "match": "\\bfunc\\b\\s+(\\w+)",
          "name": "keyword.declaration.function.nova",
          "captures": {
            "1": {
              "name": "entity.name.function.nova"
            }
          }
        }
      ]
    },
    "function_calls": {
      "patterns": [
        {
          "match": "\\b[a-zA-Z_]\\w*(?=\\s*\\()",
          "name": "entity.name.function.nova"
        }
      ]
    },
    "decorators": {
      "patterns": [
        {
          "match": "@(\\w+)",
          "captures": {
            "1": {
              "name": "entity.name.function.nova"
            }
          }
        }
      ]
    },
    "custom_types": {
      "patterns": [
        {
          "match": "\\bdefine\\b\\s+(\\w+)",
          "name": "keyword.declaration.nova",
          "captures": {
            "1": {
              "name": "entity.name.type.nova"
            }
          }
        }
      ]
    },
    "enum_definition": {
      "patterns": [
        {
          "match": "\\benum\\b",
          "name": "keyword.declaration.nova"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "match": "\\b(true|false)\\b",
          "name": "constant.language.nova"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "match": "\\b(matches|strict|default)\\b",
          "name": "keyword.declaration.nova",
          "captures": {
            "1": {
              "name": "keyword.declaration.nova"
            }
          }
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "match": "==|!=|<=|>=|\\+=|between|-=|\\*=|/=|&&|\\|\\||[=+\\-*/<>!]",
          "name": "keyword.operator.nova"
        },
        {
          "match": "[\\(\\)\\[\\]\\{\\}\\.,:]",
          "name": "punctuation.separator.nova"
        }
      ]
    }
  }
}
