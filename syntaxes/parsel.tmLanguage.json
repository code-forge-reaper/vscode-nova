{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "Parsel",
    "fileTypes": [
        "par"
    ],
    "scopeName": "source.parsel",
    "patterns": [
        {
            "include": "#comments"
        },
        {
            "include": "#strings"
        },
        {
            "include": "#numbers"
        },
        {
            "include": "#function_definitions"
        },
        {
            "include": "#keywords"
        },
        {
            "include": "#builtins"
        },
        {
            "include": "#namespace_definition"
        },
        {
            "include": "#function_calls"
        },
        {
            "include": "#operators"
        },
        {
            "include": "#types"
        },
        {
            "match": "\\b[a-zA-Z_]\\w*\\b",
            "name": "variable.other.parsel"
        }
    ],
    "repository": {
        "comments": {
            "patterns": [
                {
                    "match": "//.*$",
                    "name": "comment.line.double-slash.parsel"
                },
                {
                    "begin": "/\\*",
                    "end": "\\*/",
                    "name": "comment.block.parsel",
                    "patterns": [
                        {
                            "match": ".+"
                        }
                    ]
                }
            ]
        },
        "strings": {
            "patterns": [
                {
                    "begin": "\"",
                    "end": "\"",
                    "name": "string.quoted.double.parsel",
                    "patterns": [
                        {
                            "match": "\\\\.",
                            "name": "constant.character.escape.parsel"
                        }
                    ]
                }
            ]
        },
        "numbers": {
            "patterns": [
                {
                    "match": "\\b-?\\d+(\\.\\d+)?\\b",
                    "name": "constant.numeric.parsel"
                }
            ]
        },
        "keywords": {
            "patterns": [
                {
                    "match": "\\b(var|func|def|return|import|char|scene)\\b",
                    "name": "keyword.declaration.parsel"
                },
                {
                    "match": "\\b(end|if|else|elseif|goto|pause|exit|begin|to|in)\\b",
                    "name": "keyword.control.flow.parsel"
                },
                {
                    "match": "\\b(say|narrate|think|options|set)\\b",
                    "name": "keyword.statement.parsel"
                },
                {
                    "match": "\\bas\\b\\s+(\\w+)",
                    "captures": {
                        "1": {
                            "name": "entity.name.label.parsel"
                        }
                    },
                    "name": "keyword.control.flow.parsel"
                }
            ]
        },
        "function_definitions": {
            "patterns": [
                {
                    "match": "\\bfunc\\b\\s+(\\w+)",
                    "captures": {
                        "1": {
                            "name": "entity.name.function.parsel"
                        }
                    },
                    "name": "keyword.declaration.function.parsel"
                },
                {
                    "match": "\\bdef\\b(?=\\s*\\()",
                    "name": "keyword.declaration.function.parsel"
                }
            ]
        },
        "function_calls": {
            "patterns": [
                {
                    "match": "\\b[a-zA-Z_]\\w*(?=\\()",
                    "name": "entity.name.function.parsel"
                },
                {
                    "match": "(\\b[a-zA-Z_]\\w*)\\.(\\b[a-zA-Z_]\\w*)",
                    "captures": {
                        "1": {
                            "name": "variable.other.object.parsel"
                        },
                        "2": {
                            "name": "variable.property.parsel"
                        }
                    }
                }
            ]
        },
        "types": {
            "patterns": [
                {
                    "match": "\\b(string|number|boolean|void|bool)\\b",
                    "name": "storage.type.parsel"
                }
            ]
        },
        "builtins": {
            "patterns": [
                {
                    "match": "\\b(true|false)\\b",
                    "name": "constant.language.parsel"
                }
            ]
        },
        "namespace_definition": {
            "patterns": [
                {
                    "match": "\\b(using)\\b\\s+(\\w+)",
                    "captures": {
                        "1": {
                            "name": "keyword.declaration.parsel"
                        },
                        "2": {
                            "name": "entity.name.namespace.parsel"
                        }
                    }
                }
            ]
        },
        "operators": {
            "patterns": [
                {
                    "match": "==|!=|<=|>=|\\+=|-=|\\*=|/=|%=|&&|\\|\\|",
                    "name": "keyword.operator.parsel"
                },
                {
                    "match": "[=+\\-*/%<>!.]",
                    "name": "keyword.operator.parsel"
                },
                {
                    "match": "[\\(\\)\\[\\]\\{\\},:#]",
                    "name": "punctuation.separator.parsel"
                }
            ]
        }
    }
}